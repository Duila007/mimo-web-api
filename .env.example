# ================= mimo-web-api 配置 =================

# ────────────────────────────────────────────────
# 账号配置（二选一，也可同时配置组成账号池）
# ────────────────────────────────────────────────

# 【方式一：AT/RT 模式（推荐，长期免维护）】
# 用长效的 passToken（相当于 RT）配置账号，服务端会在会话失效时
# 自动通过小米 STS 换发新的 serviceToken（相当于 AT），无需人工刷新。
# 获取 passToken：浏览器登录 aistudio.xiaomimimo.com 后，打开
# DevTools -> 应用(Application) -> Cookie -> https://account.xiaomi.com
# -> 复制 passToken 的值（或在 Network 面板找 account.xiaomi.com 请求的 Cookie 头）。
# 多账号写成一个 JSON 数组（.env 中单行）。
MIMO_ACCOUNTS=[{"userId":"10000000001","passToken":"把这里替换成你的passToken"}]

# AT/RT 会话保活周期（小时），0 = 关闭；失效时也会在 401 后即时换发
SESSION_REFRESH_HOURS=6

# 工具透传（OpenAI function calling 模拟）：客户端发送 tools 参数时
# 自动注入工具协议并解析模型输出为标准 tool_calls。
# 全局默认开；单个请求可用 "tool_passthrough": false 关闭。
TOOL_PASSTHROUGH=true

# 【方式二：Cookie 模式（简单但短期）】
# 填入完整 Cookie（含 httpOnly 的 serviceToken），从 DevTools 的
# Network 面板复制（document.cookie 拿不到 httpOnly 字段）。
# 多账号用换行分隔。会话过期后需要手动重新抓取。
# MIMO_COOKIES=userId=xxxxxx; xiaomichatbot_ph="xxxx"; xiaomichatbot_serviceToken="xxxx"; ...

# ────────────────────────────────────────────────

# 反代自身的访问密钥（Bearer）。逗号分隔可配多个；留空 = 不鉴权（不建议公网部署时留空）
API_KEY=sk-mimo-your-secret-key

# 服务监听
HOST=0.0.0.0
PORT=8000

# 默认模型（客户端未传 model 时使用）
DEFAULT_MODEL=mimo-v2.6-pro

# 多轮上下文模式：
#   chain = 回放全部 user 消息并用上游 dialogId 续链（上下文准确，消耗配额较多）
#   last  = 只发送最后一条 user 消息（最省配额，但无历史上下文）
MIMO_CONTEXT_MODE=chain

# 上游请求超时（毫秒）
REQUEST_TIMEOUT_MS=300000

# 日志级别 debug|info|warn|error
LOG_LEVEL=info

# 跨域白名单（逗号分隔的 Origin；留空=不允许跨域；* = 放开所有来源）
ALLOWED_ORIGINS=
